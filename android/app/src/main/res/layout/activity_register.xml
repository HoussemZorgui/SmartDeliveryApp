<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Bottom Glow Effect (left) -->
        <View
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:background="@drawable/bg_glow"
            android:translationX="-80dp"
            android:translationY="150dp"
            android:alpha="0.2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingTop="64dp"
            android:paddingBottom="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créer un compte"
                android:textSize="38sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rejoignez Smart Delivery dès aujourd'hui."
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Username -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlUsername"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:hint="Nom d'utilisateur"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:startIconDrawable="@drawable/ic_profile"
            app:startIconTint="@color/text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/usernameInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlEmail"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="14dp"
            android:hint="Adresse Email"
            app:layout_constraintTop_toBottomOf="@id/tlUsername"
            app:startIconDrawable="@drawable/ic_mail"
            app:startIconTint="@color/text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tlPassword"
            style="@style/Widget.App.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="14dp"
            android:hint="Mot de passe"
            app:layout_constraintTop_toBottomOf="@id/tlEmail"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_hint"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/text_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:inputType="textPassword"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Role Selector Title -->
        <TextView
            android:id="@+id/tvRoleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="24dp"
            android:text="Je suis un ..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/tlPassword" />

        <!-- Role Toggle Buttons -->
        <LinearLayout
            android:id="@+id/roleLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="8dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@id/tvRoleTitle">

            <!-- Client Card -->
            <LinearLayout
                android:id="@+id/cardClient"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_role_selected"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧑"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvClientLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Client"
                    android:textColor="@color/accent_volt"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Driver Card -->
            <LinearLayout
                android:id="@+id/cardDriver"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_role_unselected"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛵"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/tvDriverLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Livreur"
                    android:textColor="@color/text_hint"
                    android:fontFamily="sans-serif-black"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Register Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSignUp"
            style="@style/Widget.App.Button"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="28dp"
            android:text="Créer mon compte"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:backgroundTint="@color/accent_volt"
            app:layout_constraintTop_toBottomOf="@id/roleLayout" />

        <!-- Back to Login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp"
            android:text="J'ai déjà un compte → Se connecter"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintTop_toBottomOf="@id/btnSignUp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone"
            android:indeterminateTint="@color/accent_volt"
            app:layout_constraintStart_toStartOf="@id/btnSignUp"
            app:layout_constraintEnd_toEndOf="@id/btnSignUp"
            app:layout_constraintTop_toTopOf="@id/btnSignUp"
            app:layout_constraintBottom_toBottomOf="@id/btnSignUp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
